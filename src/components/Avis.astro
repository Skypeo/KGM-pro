---
import ReviewsCarousel from "./ui/ReviewsCarousel.tsx";
import BlurText from "./ui/BlurText.tsx";
import { AVIS, GOOGLE_RATING, GOOGLE_REVIEWS_URL } from "../data/avis";
---

<section id="avis" class="crepi-dark relative bg-mauve-950 py-20 text-cream-50 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center reveal">
      <p class="inline-flex items-center gap-3 text-[11px] uppercase tracking-[0.28em] text-mauve-300">
        <span class="h-px w-8 bg-mauve-400/60"></span>
        Témoignages
        <span class="h-px w-8 bg-mauve-400/60"></span>
      </p>
      <h2 class="mt-6 font-display text-3xl leading-[1.2] text-white sm:text-4xl lg:text-5xl">
        {GOOGLE_RATING.value} / 5 sur Google.
        <br class="hidden sm:block" />
        Et chaque avis cite Gary <span class="script-gradient italic">par son prénom</span>.
      </h2>
    </div>

    <!-- Widget Google compact -->
    <div class="mx-auto mt-12 max-w-md sm:mt-14 reveal" style="--reveal-delay: 100ms;">
      <article class="rounded-2xl bg-cream-50 p-6 text-ink-900 shadow-2xl shadow-mauve-950/40 ring-1 ring-mauve-200/60 sm:p-7">
        <div class="flex items-center justify-center gap-2.5">
          <svg viewBox="0 0 24 24" class="h-6 w-6" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.75h3.57c2.08-1.92 3.28-4.74 3.28-8.07z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.75c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0 0 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.12A6.6 6.6 0 0 1 5.5 12c0-.74.13-1.45.34-2.12V7.04H2.18A11 11 0 0 0 1 12c0 1.78.43 3.46 1.18 4.96l3.66-2.84z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.04l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
          </svg>
          <span class="text-sm font-medium">Avis Google</span>
        </div>

        <div class="mt-4 flex items-baseline justify-center gap-1.5">
          <span class="font-display text-6xl leading-none">{GOOGLE_RATING.value}</span>
          <span class="text-lg text-mauve-400">/ 5</span>
        </div>

        <div class="mt-3 flex justify-center gap-1">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 24 24" fill="#F5A623" class="h-5 w-5">
              <path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.7 7-6.3-3.8-6.3 3.8 1.7-7L2 9.5l7.1-.6L12 2z"/>
            </svg>
          ))}
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 text-[12px]">
          <span class="text-ink-700/70">Basé sur {GOOGLE_RATING.count} avis</span>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-emerald-700 ring-1 ring-emerald-200">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3">
              <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Vérifiés
          </span>
        </div>

        <a
          href={GOOGLE_REVIEWS_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-mauve-500 px-6 py-3 text-sm font-medium text-cream-50 shadow-lg shadow-mauve-950/20 transition hover:bg-mauve-400 hover:shadow-xl"
        >
          Voir tous les avis sur Google
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-4 w-4">
            <line x1="5" y1="12" x2="19" y2="12" stroke-linecap="round"/>
            <polyline points="12 5 19 12 12 19" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </article>
    </div>

    <!-- Carousel React : pile de témoignages qui défile, navigable au clavier -->
    <ReviewsCarousel
      client:visible
      reviews={AVIS}
      autoPlay
      autoPlayInterval={6000}
      height="360px"
      className="mt-6 sm:mt-8"
    />

    <BlurText
      client:visible
      text={`Faites défiler avec les flèches ou glissez, ${GOOGLE_RATING.count} avis publics au total.`}
      animateBy="words"
      delay={25}
      className="mt-2 justify-center text-[12px] text-cream-100/50"
    />
  </div>
</section>
