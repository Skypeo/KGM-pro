---
import { getImage } from "astro:assets";
import Masonry from "./ui/Masonry.tsx";
import SplitText from "./ui/SplitText.tsx";

import moulureOrnement from "../assets/realisations/moulure/moulure-09.webp";
import moulureCorniche from "../assets/realisations/moulure/moulure-16.webp";
import moulureRosace from "../assets/realisations/moulure/moulure-04.webp";
import fauxCiel from "../assets/realisations/faux-ciel/faux-ciel-01.webp";
import betonCire from "../assets/realisations/beton-cire/beton-cire-01.webp";
import facadeTerminee from "../assets/realisations/peinture-exterieure/peinture-exterieure-21.webp";
import verriereAtelier from "../assets/realisations/renovation/renovation-05.webp";
import doucheBetonCire from "../assets/realisations/renovation/renovation-17.webp";
import peintureDeco from "../assets/realisations/peinture-decorative/peinture-decorative-01.webp";
import peintureInt from "../assets/realisations/peinture-interieure/peinture-interieure-01.webp";

// Hauteurs volontairement variées pour un vrai rendu masonry (le composant divise
// height/2 pour la hauteur rendue). Images optimisées au build (webp 560px) avant
// d'être passées à l'îlot React Masonry qui n'accepte que des URLs.
const sources = [
  { src: moulureOrnement, height: 720 },
  { src: facadeTerminee, height: 520 },
  { src: fauxCiel, height: 600 },
  { src: betonCire, height: 460 },
  { src: verriereAtelier, height: 640 },
  { src: moulureCorniche, height: 500 },
  { src: doucheBetonCire, height: 700 },
  { src: peintureDeco, height: 560 },
  { src: peintureInt, height: 480 },
  { src: moulureRosace, height: 620 },
];

const items = await Promise.all(
  sources.map(async (s, i) => {
    const optimized = await getImage({ src: s.src, width: 560, format: "webp" });
    return {
      id: String(i),
      img: optimized.src,
      url: "/realisations",
      height: s.height,
    };
  })
);
---

<section id="realisations" class="crepi relative bg-cream-50 py-20 sm:py-24 lg:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-10">
    <!-- Header -->
    <div class="mx-auto max-w-3xl text-center reveal">
      <p class="inline-flex items-center gap-3 text-[11px] uppercase tracking-[0.28em] text-mauve-600">
        <span class="h-px w-8 bg-mauve-300"></span>
        Réalisations
        <span class="h-px w-8 bg-mauve-300"></span>
      </p>
      <h2 class="mt-6 font-display text-3xl leading-[1.15] text-ink-900 sm:text-4xl lg:text-5xl">
        Le geste artisanal,
        <br class="hidden sm:block" />
        <span class="script-gradient italic">en images</span>.
      </h2>
      <SplitText
        client:visible
        text="Quelques chantiers récents, de la moulure au béton ciré."
        tag="p"
        splitType="words"
        delay={30}
        duration={0.8}
        className="mt-5 w-full text-sm leading-relaxed text-ink-700/75 sm:text-base"
      />
    </div>

    <!-- Masonry React : mosaïque animée à l'entrée (stagger + blur), scale au survol -->
    <div class="mt-14 lg:mt-16">
      <Masonry
        client:load
        items={items}
        animateFrom="bottom"
        duration={0.6}
        stagger={0.06}
        scaleOnHover={true}
        hoverScale={0.96}
        blurToFocus={true}
      />
    </div>

    <div class="mt-14 text-center">
      <a
        href="/realisations"
        class="inline-flex items-center gap-2 rounded-full bg-mauve-500 px-6 py-3.5 text-sm font-medium text-cream-50 shadow-md shadow-mauve-500/20 transition hover:bg-mauve-600"
      >
        Voir toutes les réalisations →
      </a>
    </div>
  </div>
</section>
