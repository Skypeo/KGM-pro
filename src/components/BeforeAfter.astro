---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  /** Titre du chantier, ex. "Ravalement de façade" */
  titre?: string;
  /** Localisation / contexte, ex. "Nancy — 2025" */
  meta?: string;
  /** Ratio de l'image, défaut 4/3 */
  ratio?: string;
}

const {
  before,
  after,
  beforeAlt,
  afterAlt,
  titre,
  meta,
  ratio = "4 / 3",
} = Astro.props;
---

<figure class="ba group flex flex-col gap-5">
  <div
    class="ba-stage relative w-full select-none overflow-hidden rounded-lg bg-mauve-100"
    style={`aspect-ratio:${ratio}; --pos:50%;`}
  >
    <!-- APRÈS — calque de base -->
    <Image
      src={after}
      alt={afterAlt}
      widths={[480, 720, 1080, 1440]}
      sizes="(min-width: 768px) 45vw, 100vw"
      class="absolute inset-0 h-full w-full object-cover"
      draggable={false}
    />

    <!-- AVANT — calque clippé par --pos -->
    <div class="ba-before absolute inset-0 h-full w-full overflow-hidden">
      <Image
        src={before}
        alt={beforeAlt}
        widths={[480, 720, 1080, 1440]}
        sizes="(min-width: 768px) 45vw, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
        draggable={false}
      />
    </div>

    <!-- Étiquettes -->
    <span class="ba-tag pointer-events-none absolute left-4 top-4 rounded-full bg-mauve-950/55 px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-cream-50 backdrop-blur">
      Avant
    </span>
    <span class="ba-tag pointer-events-none absolute right-4 top-4 rounded-full bg-cream-50/85 px-3 py-1 text-[11px] uppercase tracking-[0.18em] text-ink-900 backdrop-blur">
      Après
    </span>

    <!-- Ligne + poignée -->
    <div class="ba-divider pointer-events-none absolute inset-y-0 w-px bg-cream-50/90">
      <span class="absolute left-1/2 top-1/2 flex h-11 w-11 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full bg-cream-50 text-mauve-700 shadow-lg ring-1 ring-mauve-950/10">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
          <polyline points="11 7 6 12 11 17" stroke-linecap="round" stroke-linejoin="round" />
          <polyline points="13 7 18 12 13 17" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
    </div>

    <!-- Contrôle accessible (clavier + drag) -->
    <input
      type="range"
      class="ba-range absolute inset-0 h-full w-full cursor-ew-resize appearance-none bg-transparent"
      min="0"
      max="100"
      value="50"
      step="0.1"
      aria-label={`Glisser pour comparer avant et après${titre ? ` — ${titre}` : ""}`}
    />
  </div>

  {(titre || meta) && (
    <figcaption class="space-y-1">
      {meta && <p class="text-[11px] uppercase tracking-[0.22em] text-mauve-600">{meta}</p>}
      {titre && <h3 class="font-display text-2xl leading-tight text-ink-900">{titre}</h3>}
    </figcaption>
  )}
</figure>

<style>
  /* clip du calque AVANT et position de la ligne pilotés par --pos */
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-divider {
    left: var(--pos);
  }
  /* On masque le thumb natif : le drag est capté sur toute la surface */
  .ba-range::-webkit-slider-thumb {
    appearance: none;
    width: 44px;
    height: 100%;
  }
  .ba-range::-moz-range-thumb {
    width: 44px;
    height: 100%;
    border: 0;
    background: transparent;
  }
  .ba-range:focus-visible {
    outline: 2px solid var(--color-mauve-500, #8b5cf6);
    outline-offset: 3px;
    border-radius: 0.5rem;
  }
</style>

<script>
  for (const stage of document.querySelectorAll<HTMLElement>(".ba-stage")) {
    const range = stage.querySelector<HTMLInputElement>(".ba-range");
    if (!range) continue;
    const sync = () => stage.style.setProperty("--pos", `${range.value}%`);
    range.addEventListener("input", sync);
    sync();
  }
</script>
